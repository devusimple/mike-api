# ============================================================
# Secrets model (read before changing this file):
# - Remote secrets live ONLY in `wrangler secret` store
#   (JWT_SECRET, CLOUDINARY_API_SECRET) — never in files.
# - Local secrets live ONLY in `.dev.vars` (gitignored).
# - `wrangler.jsonc` holds PUBLIC values only
#   (CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_FOLDER).
#   The full CLOUDINARY_URL (it embeds the api secret) must
#   NEVER be pasted into any file in this repo.
# ============================================================

# --- local secrets (never commit) ---
.dev.vars
.dev.vars.*
!.dev.vars.example
.env*
!.env.example
*.pem
*.key
*secret*.txt
secrets/

# --- cloudflare / wrangler ---
.wrangler/
# worker-configuration.d.ts is generated (`bun run cf-typegen`) but
# intentionally committed so editors work on fresh clones.

# --- local databases (dev data, may contain test users) ---
*.db
*.sqlite
*.sqlite-journal
drizzle/local.db*

# --- dependencies (bun.lock IS committed intentionally) ---
node_modules/
.yarn/
!.yarn/releases

# --- build outputs ---
dist/
build/
coverage/

# --- logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- editors ---
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# --- OS / misc ---
.DS_Store
Thumbs.db
