{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "dxat06es",
